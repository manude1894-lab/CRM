{
  "_comment": "Contract between the submit rule (backend missing_mandatory) and the form's asterisks (frontend mandatoryFields). Both test suites run these cases, so the screen and the server can't disagree.",
  "common": ["anchor_entity", "services_obtained", "spoc_id", "search_name", "company_name",
    "br_person_met", "br_meeting_date", "br_meeting_time", "br_meeting_place", "br_meeting_mode", "br_rationale",
    "engagement_letter_signed"],
  "corporate_always": ["client_category", "country", "contact_mobile_number", "contact_mobile_country_code", "contact_email",
    "nature_of_services_sought", "licensing_authority", "is_regulated", "has_introducer"],
  "existing_company": ["registration_number", "incorporation_date", "license_number", "license_start_date", "license_expiry_date",
    "license_activities", "registered_address", "operating_address"],
  "tax": ["financial_year_end", "corp_tax_registered"],
  "cases": [
    {"name": "Existing company", "form": {"account_type": "Corporate", "client_category": "Existing"},
      "groups": ["common", "corporate_always", "existing_company", "tax"], "extra": []},
    {"name": "Category not chosen yet", "form": {"account_type": "Corporate", "services_obtained": ["Company Formation Services"]},
      "groups": ["common", "corporate_always", "existing_company", "tax"], "extra": []},
    {"name": "Under Formation", "form": {"account_type": "Corporate", "client_category": "Under Formation"},
      "groups": ["common", "corporate_always"], "extra": []},
    {"name": "Under Formation and regulated", "form": {"account_type": "Corporate", "client_category": "Under Formation", "is_regulated": true},
      "groups": ["common", "corporate_always"], "extra": ["regulator_name", "license_category"]},
    {"name": "Registered in BVI", "form": {"account_type": "Corporate", "client_category": "Existing", "country": "Virgin Islands (British)"},
      "groups": ["common", "corporate_always", "existing_company"], "extra": []},
    {"name": "Registered in British Virgin Islands", "form": {"account_type": "Corporate", "client_category": "Existing", "country": "British Virgin Islands"},
      "groups": ["common", "corporate_always", "existing_company"], "extra": []},
    {"name": "US Virgin Islands is not BVI", "form": {"account_type": "Corporate", "client_category": "Existing", "country": "Virgin Islands (U.S.)"},
      "groups": ["common", "corporate_always", "existing_company", "tax"], "extra": []},
    {"name": "BVI anchor entity", "form": {"account_type": "Corporate", "client_category": "Existing", "anchor_entity": "TBVI"},
      "groups": ["common", "corporate_always", "existing_company"], "extra": []},
    {"name": "Offshore, not BVI, by service", "form": {"account_type": "Corporate", "client_category": "Existing", "services_obtained": ["Offshore Company Formation Services"]},
      "groups": ["common", "corporate_always", "existing_company"], "extra": []},
    {"name": "Offshore by registering authority", "form": {"account_type": "Corporate", "client_category": "Existing", "licensing_authority": "Offshore - Non-BVI"},
      "groups": ["common", "corporate_always", "existing_company"], "extra": []},
    {"name": "Regulated with Other regulator", "form": {"account_type": "Corporate", "client_category": "Existing", "is_regulated": true, "regulator_name": "Other"},
      "groups": ["common", "corporate_always", "existing_company", "tax"], "extra": ["regulator_name", "regulator_other", "license_category", "regulatory_license_expiry_date"]},
    {"name": "Other registering authority", "form": {"account_type": "Corporate", "client_category": "Existing", "licensing_authority": "Other"},
      "groups": ["common", "corporate_always", "existing_company", "tax"], "extra": ["licensing_authority_other"]},
    {"name": "Has introducer and engagement letter", "form": {"account_type": "Corporate", "client_category": "Existing", "has_introducer": true, "engagement_letter_signed": true},
      "groups": ["common", "corporate_always", "existing_company", "tax"], "extra": ["introducer_name", "engagement_letter_valid_until"]},
    {"name": "Foundation", "form": {"account_type": "Corporate", "client_category": "Existing", "services_obtained": ["Set up Foundations"]},
      "groups": ["common", "corporate_always", "existing_company", "tax"], "extra": []},
    {"name": "Individual", "form": {"account_type": "Individual"}, "groups": ["common"],
      "extra": ["date_of_birth", "passport_expiry_date", "country_of_birth", "nationality", "country_of_residence", "individual_mobile_number",
        "individual_mobile_country_code", "individual_email", "nature_of_services_sought", "residential_address"]}
  ]
}
