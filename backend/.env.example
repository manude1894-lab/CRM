# EZEETECH GROUP — environment variables
# Copy to .env and adjust

# Database
DATABASE_URL=postgresql+psycopg2://crm_user:crm_password@localhost:5432/prognica_crm

# JWT - MUST be changed in production (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-in-production-generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET_KEY=change-me-refresh-secret-different-from-access-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
DEBUG=false
API_V1_PREFIX=/api/v1

# SMTP — existing org mailbox, used for notification emails (no paid SaaS service)
SMTP_ENABLED=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=notifications@yourfirm.com
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=notifications@yourfirm.com
SMTP_FROM_NAME=EZEETECH GROUP
SMTP_USE_TLS=true

# Compliance cadence — anchored to the BVI calendar (see case_service)
RENEWAL_CADENCE_MONTHS=12
ESR_FILING_CADENCE_MONTHS=12
AR_FILING_CADENCE_MONTHS=12
BO_FILING_DEADLINE_DAYS=30
